// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "off",
  "remove_trailing_whitespace_on_save": false,
  "ensure_final_newline_on_save": false,
  "terminal": {
    "font_weight": 400.0,
    "font_size": 14.0,
    "font_family": "Agave Nerd Font",
    "dock": "right",
  },
  "status_bar": {
    "active_language_button": true,
  },
  "project_panel": {
    "button": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "VSCode",
  "ui_font_family": "IBM Plex Sans",
  "buffer_line_height": {
    "custom": 1.0,
  },
  "buffer_font_weight": 400.0,
  "buffer_font_family": "IBM Plex Sans",
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Dark",
    "dark": "Gruvbox Dark",
  },
  "disable_ai": true,
  "minimap": {
    "show": "never",
    "thumb": "always",
    "thumb_border": "left_open",
    "current_line_highlight": null,
  },
  "experimental.theme_overrides": {
    "background.appearance": "blurred",
    "background": "#4c4642DE",
    "editor.background": "#00000030",
    "editor.gutter.background": "#00000030",
    "tab_bar.background": "#00000030",
    "terminal.background": "#00000030",
    "toolbar.background": "#00000030",
    "tab.active_background": "#28282820",
    "tab.inactive_background": "#00000000",
    "status_bar.background": "#00000030",
    "title_bar.background": "#00000030",
    "panel.background": "#00000030",
    "border.variant": "#00000000",
    "scrollbar.track.border": "#00000000",
    "editor.active_line.background": "#00000000",
  },
}
