{
  "output": "DP-2",
  "layer": "top",
  "spacing": 0,
  "height": 0,
  "margin-top": 0,
  "position": "bottom",
  "margin-right": -1,
  "margin-bottom": -3,
  "margin-left": -1,

  "modules-left": [
    "power-profiles-daemon",
    "memory", 
    "custom/separator",
    "custom/playerctl"
  ],

  "modules-center": ["hyprland/workspaces"],

  "modules-right": ["hyprland/window", "custom/separator", "privacy", "pulseaudio#microphone", "pulseaudio", "tray", "hyprland/language", "clock"],

  "include": "~/.config/waybar/modules.jsonc"
}
